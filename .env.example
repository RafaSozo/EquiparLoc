# Copie este arquivo para .env.local e preencha os valores.
# NUNCA coloque senhas reais neste arquivo de exemplo.

# GEMINI_API_KEY: chave da API do Gemini (gerador de SEO do blog).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: endereço público do site (ex.: https://equiparloc.com.br).
APP_URL="MY_APP_URL"

# Login do painel administrativo (/admin)
ADMIN_EMAIL="admin@suaempresa.com.br"
ADMIN_PASSWORD="troque-por-uma-senha-forte"
ADMIN_NAME="Administrador"

# Opcional: segundo usuário (operador comercial, não pode excluir itens)
# OPERADOR_EMAIL="comercial@suaempresa.com.br"
# OPERADOR_PASSWORD="outra-senha-forte"

# NEXTAUTH_SECRET: chave que assina a sessão de login. Obrigatória em produção.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="gere-uma-chave-aleatoria"

# NEXTAUTH_URL: endereço base do site (o mesmo de APP_URL em produção).
NEXTAUTH_URL="http://localhost:3000"

# TRUSTED_IP_HEADER: cabeçalho com o IP real do visitante, preenchido SÓ pela hospedagem.
# Cloudflare: cf-connecting-ip | Vercel: x-real-ip | nginx: x-real-ip (configurado no proxy).
# Deixe vazio no computador. Em produção, preencha para o limite de envios não ser burlado.
TRUSTED_IP_HEADER=""

# DATA_DIR: pasta onde ficam o banco, as fotos enviadas pelo painel e os backups.
# Vazio = pasta data/ do projeto. Na hospedagem, use um caminho FORA da pasta do site
# (ex.: /home/usuario/equiparloc-data) para que uma nova publicação não apague nada.
DATA_DIR=""
